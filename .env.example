# Neon DB (get from Vercel / Neon dashboard)
DATABASE_URL=postgresql://user:pass@host/dbname?sslmode=require

# Admin panel password
ADMIN_PASSWORD=your-secure-password-here

# HMAC secret for admin cookie (any random string, keep secret)
ADMIN_SECRET=your-hmac-secret-here

# Public base URL (no trailing slash)
NEXT_PUBLIC_BASE_URL=https://yourdomain.com

# YouTube API (optional — videos page)
YOUTUBE_API_KEY=
YOUTUBE_CHANNEL_ID=

# --- Tech Radar ingestion -----------------------------------------------------
# Shared secret for POST /api/radar. The local runner sends it as
# "Authorization: Bearer <key>". Generate with: openssl rand -hex 32
# If unset the endpoint rejects every request.
RADAR_API_KEY=

# Where the "new draft ready" notification goes.
RADAR_NOTIFY_EMAIL=you@example.com

# Gmail transport for that notification (reuses the contact-form mail path).
GMAIL_USER=
GMAIL_APP_PASSWORD=
